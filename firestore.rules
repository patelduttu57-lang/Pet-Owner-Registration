rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidPetOwner(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.fullName is string && data.fullName.size() >= 2 && data.fullName.size() <= 100 &&
             data.email is string && data.email.size() >= 3 && data.email.size() <= 120 &&
             data.mobileNumber is string && data.mobileNumber.size() >= 5 && data.mobileNumber.size() <= 30 &&
             data.residentialAddress is string && data.residentialAddress.size() >= 3 && data.residentialAddress.size() <= 250 &&
             data.petName is string && data.petName.size() >= 1 && data.petName.size() <= 80 &&
             data.petType is string && data.petType.size() >= 1 && data.petType.size() <= 50 &&
             data.petBreed is string && data.petBreed.size() >= 1 && data.petBreed.size() <= 80 &&
             data.petAge is string && data.petAge.size() >= 1 && data.petAge.size() <= 40;
    }

    match /users/{userId}/pet_owners/{registrationId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(registrationId);

      allow list: if isOwner(userId) && isValidId(userId);

      allow create: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(registrationId) &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'userId', 'fullName', 'email', 'mobileNumber', 'residentialAddress',
                         'petName', 'petType', 'petBreed', 'petAge', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'fullName', 'email', 'mobileNumber', 'residentialAddress',
                         'petName', 'petType', 'petBreed', 'petAge', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().createdAt is timestamp &&
                       incoming().createdAt <= request.time &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       isValidPetOwner(incoming());

      allow update: if isOwner(userId) &&
                       isValidId(userId) &&
                       isValidId(registrationId) &&
                       isValidPetOwner(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().updatedAt is timestamp &&
                       incoming().updatedAt <= request.time &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'fullName', 'email', 'mobileNumber', 'residentialAddress',
                         'petName', 'petType', 'petBreed', 'petAge', 'updatedAt'
                       ]);

      allow delete: if isOwner(userId) && isValidId(userId) && isValidId(registrationId);
    }
  }
}
